# ============================================================
# AirAware Environment Configuration
# ============================================================

# AI Provider Configuration
# Supported providers: "gemini", "openai", "anthropic", "demo"
# If AI_API_KEY is not provided or set to "demo", AirAware will run in
# fully functional, evidence-grounded Deterministic Fallback Mode.
AI_PROVIDER=demo

# External AI API Key (Optional: keeps server-side, never exposed to client)
AI_API_KEY=

# Model override (Optional: defaults to gemini-1.5-flash or gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# Node Environment
NODE_ENV=development
